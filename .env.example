# Copiar a .env y poner una contrasena propia. El archivo .env esta en .gitignore
# y no se commitea nunca.
#
# SQL Server exige: 8+ caracteres con mayuscula, minuscula, digito y simbolo.
# Generar una al azar, por ejemplo:
#   openssl rand -base64 24
MSSQL_SA_PASSWORD=cambiame-por-una-contrasena-fuerte
